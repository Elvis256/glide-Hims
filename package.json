{
  "name": "glide-hims",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise HMIS/ERP for Uganda Healthcare - Offline-first, On-premise Primary",
  "author": "Glide-HIMS Team",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "audit:security": "pnpm audit --prod",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd packages/backend && pnpm db:migrate",
    "db:seed": "cd packages/backend && pnpm db:seed",
    "db:setup": "sudo -u postgres psql -c \"CREATE USER glide_hims WITH PASSWORD 'glide_hims_dev';\" && sudo -u postgres psql -c \"CREATE DATABASE glide_hims_dev OWNER glide_hims;\"",
    "db:reset": "cd packages/backend && pnpm db:migrate && pnpm db:seed",
    "security:audit:root": "pnpm audit --prod --audit-level=high",
    "security:audit:backend": "pnpm -C packages/backend audit --prod --audit-level=high",
    "security:audit:frontend": "pnpm -C packages/frontend audit --prod --audit-level=high",
    "security:scan": "pnpm security:audit:root && pnpm security:audit:backend && pnpm security:audit:frontend",
    "compliance:evidence:init": "bash scripts/compliance/collect-evidence.sh"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "pnpm": {
    "overrides": {
      "tar@<7.5.19": ">=7.5.19",
      "multer@<2.1.1": ">=2.1.1",
      "axios@<1.16.0": ">=1.16.0",
      "socket.io-parser@<4.2.7": ">=4.2.7",
      "js-yaml@<4.3.1": ">=4.3.1",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "lodash@<4.18.0": ">=4.18.0",
      "form-data@<4.0.6": ">=4.0.6",
      "multer@<2.2.0": ">=2.2.0",
      "nodemailer@<9.0.1": ">=9.0.1",
      "ws@<8.21.0": ">=8.21.0",
      "engine.io@<6.6.7": ">=6.6.7",
      "minimatch@>=3.0.0 <3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <3.0.6": "3.0.6",
      "brace-expansion@>=4.0.0 <5.0.0": "4.0.1",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9"
    }
  }
}
